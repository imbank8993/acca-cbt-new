# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js
.next/
out/

# nestjs
apps/api/dist/
apps/api/prisma/generated/

# paket internal yang di-build
packages/*/dist/
packages/*/src/*.js
packages/*/src/*.d.ts
packages/*/src/*.js.map

# fastapi / python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# production
build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!**/.env.example
!.env.docker.example

# vercel
.vercel

# uploads
apps/web/public/uploads/

# typescript
*.tsbuildinfo
next-env.d.ts

# local tooling & scratch
.claude/skills/
/scratch/
/tmp/
/docx_unzip/

# Custom test and scratch files
test_*.mjs
test_*.js
tmp_*.js
simulate_*.js
list_*.js
check_*.js
debug_*.js
*.log

# Scratch SQL only — `database/` and `apps/api/prisma/` are tracked on purpose.
/*.sql
apps/web/**/*.sql

tools/test-parser.js
tools/generate-template.js
tools/generate-template.mjs
apps/web/lib/doc-parser-node.js
