# ==============================================================================
# ACCA CBT - Docker Environment Configuration Template
# Salin berkas ini ke `.env` di root project saat deploy di VPS:
#   cp .env.docker.example .env
# ==============================================================================

# ─── Port Host VPS ────────────────────────────────────────────────────────────
# Port yang dibuka ke host VPS untuk diakses Nginx (default: 3008)
CBT_WEB_PORT=3008

# ─── URL Publik Aplikasi ──────────────────────────────────────────────────────
# Sesuaikan dengan domain asli Anda di VPS (atau http://ip-vps:3008 jika belum ada domain)
NEXT_PUBLIC_SITE_URL=https://cbt.domainanda.com
NEXT_PUBLIC_ACCA_URL=https://acca.domainanda.com

# ─── Database PostgreSQL ──────────────────────────────────────────────────────
# Jika PostgreSQL jalan di host OS VPS, gunakan host.docker.internal:
DATABASE_URL="postgresql://postgres:password_postgres_anda@host.docker.internal:5432/acca_db?schema=public"

# Jika PostgreSQL jalan di container docker yang sama atau server lain, ganti host-nya:
# DATABASE_URL="postgresql://postgres:password_postgres_anda@172.17.0.1:5432/acca_db?schema=public"

# ─── Autentikasi & SSO ────────────────────────────────────────────────────────
# WAJIB SAMA PERSIS dengan JWT_SECRET dan CBT_SSO_SECRET di acca-new!
JWT_SECRET=kunci-jwt-harus-sama-dengan-acca-new
JWT_EXPIRES_IN=12h
CBT_SSO_SECRET=kunci-sso-harus-sama-dengan-acca-new

# Kunci komunikasi internal antar kontainer (ganti dengan string acak panjang)
INTERNAL_API_KEY=kunci-acak-internal-web-ke-api-987654321
SCORING_API_KEY=kunci-acak-api-ke-scoring-123456789

# ─── Data Organisasi / Sekolah ────────────────────────────────────────────────
CBT_ORGANIZATION_NAME="Nama Sekolah Anda"
CBT_ORGANIZATION_SLUG="nama-sekolah-anda"

# ─── Penyimpanan Berkas: Cloudflare R2 ────────────────────────────────────────
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=acca
# Gunakan custom domain R2 Anda (jangan pub-*.r2.dev karena diblokir beberapa provider):
CLOUDFLARE_R2_PUBLIC_URL=https://file.domainanda.com

# ─── Layanan AI & Skoring ─────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
SCORING_LOG_LEVEL=INFO

# ─── Kunci Enkripsi Backup ────────────────────────────────────────────────────
BACKUP_SECRET_KEY=kunci-enkripsi-cadangan-rahasia-cbt
