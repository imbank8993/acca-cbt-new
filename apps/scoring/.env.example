# Layanan skoring hanya dipanggil NestJS dari mesin yang sama. Ia TIDAK punya
# kredensial database: seluruh data datang lewat payload permintaan.
HOST=127.0.0.1
PORT=8000

# Harus sama dengan SCORING_API_KEY di apps/api/.env. Dikirim sebagai header
# x-api-key pada setiap permintaan.
SCORING_API_KEY=ganti-dengan-string-acak-panjang

# Integrasi AI (generate kisi-kisi, bantuan penilaian esai).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

LOG_LEVEL=INFO
