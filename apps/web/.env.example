# Salin ke apps/web/.env.local lalu isi nilainya. Berkas .env* tidak ikut
# ter-commit (lihat .gitignore), .env.example inilah yang dirawat di repo.

# ─── Jembatan ke NestJS ──────────────────────────────────────────────────────
# NestJS mendengarkan di loopback dan tidak boleh dijangkau browser.
NEST_API_URL=http://127.0.0.1:3009/api

# WAJIB SAMA PERSIS dengan JWT_SECRET di apps/api/.env. Dipakai middleware dan
# route handler untuk memverifikasi cookie sesi `cbt_session`. Kalau berbeda,
# setiap permintaan yang sudah login tetap ditolak 401.
JWT_SECRET=samakan-dengan-apps/api/.env

# Shared secret untuk memanggil endpoint /internal/* NestJS tanpa token
# pengguna. JANGAN pernah diberi prefix NEXT_PUBLIC_.
INTERNAL_API_KEY=samakan-dengan-apps/api/.env

# ─── Masuk lewat acca-new (SSO) ──────────────────────────────────────────────
# CBT TIDAK punya halaman login. Pengguna masuk di acca-new, lalu acca-new
# mengarahkan ke /api/auth/sso?token=… di sini.
#
# Alamat aplikasi WEB acca-new — bukan API NestJS-nya. Dipakai untuk memantulkan
# pengguna kembali saat ia membuka CBT tanpa sesi, dan oleh tombol "Bersihkan
# Sesi & Coba Lagi". Dev: http://localhost:3006 (API acca-new ada di :3007).
NEXT_PUBLIC_ACCA_URL=http://localhost:3006

# Alamat CBT itu sendiri. Dev: http://localhost:3008.
NEXT_PUBLIC_SITE_URL=http://localhost:3008

# Tiket SSO diverifikasi NestJS, BUKAN di sini — CBT_SSO_SECRET cukup ada di
# apps/api/.env saja. Jangan menyalinnya ke berkas ini.

# ─── Penyimpanan berkas: Cloudflare R2 ───────────────────────────────────────
# Kredensial R2 SUDAH DIPINDAHKAN ke apps/api/.env (StorageService NestJS).
# Next.js tidak lagi butuh CLOUDFLARE_R2_* di sini.
# Upload file: browser → Next.js (proxy) → NestJS /storage/upload → R2.
# Lihat apps/api/.env.example untuk konfigurasi R2 yang sebenarnya.

# ─── Ekspor/impor cadangan ───────────────────────────────────────────────────
# Kunci penanda tangan berkas .cbtbak. Ganti di produksi.
BACKUP_SECRET_KEY=
