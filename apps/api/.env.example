# ─── Server ──────────────────────────────────────────────────────────────────
# NestJS TIDAK boleh diekspos ke internet. Ia hanya dipanggil oleh route handler
# Next.js dari mesin yang sama (lihat apps/web/lib/nest-api.ts), persis seperti
# apps/api di acca-new yang dengar di 127.0.0.1:3007.
PORT=3009
HOST=127.0.0.1
CORS_ORIGIN=http://localhost:3008

# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL yang SAMA dengan acca-new. Nama database: acca_db. Satu-satunya
# sumber data sejak cutover 16 September 2026 — tidak ada lagi Supabase.
# Tabel CBT memakai prefix cbt_ di schema public; identitas ada di schema auth.
DATABASE_URL="postgresql://postgres:your_password@your-host:5432/acca_db?schema=public"

# ─── Autentikasi ─────────────────────────────────────────────────────────────
# WAJIB SAMA PERSIS dengan JWT_SECRET di acca-new (apps/api/.env dan
# apps/web/.env.local). Inilah yang membuat token acca-new langsung sah di CBT
# tanpa handshake SSO magiclink.
JWT_SECRET=samakan-dengan-acca-new
JWT_EXPIRES_IN=12h

# Shared secret antar-service: dipakai route handler Next.js memanggil endpoint
# /internal/* tanpa token user. Jangan pernah diberi prefix NEXT_PUBLIC_.
INTERNAL_API_KEY=ganti-dengan-string-acak-panjang

# Tiket SSO dari acca-app (jose JWT). Samakan dengan CBT_SSO_SECRET di acca-new.
CBT_SSO_SECRET=samakan-dengan-acca-new

# ─── Organisasi SSO ───────────────────────────────────────────────────────────
# Nama dan slug organisasi yang dibuat/dicocokkan otomatis saat SSO pertama kali.
# Sesuaikan dengan nama sekolah Anda.
# Jika CBT_ORGANIZATION_SLUG tidak diset, slug digenerate otomatis dari nama.
CBT_ORGANIZATION_NAME=Nama Sekolah Anda
CBT_ORGANIZATION_SLUG=nama-sekolah-anda

# ─── Layanan skoring & AI (FastAPI) ──────────────────────────────────────────
SCORING_API_URL=http://127.0.0.1:8000
SCORING_API_KEY=ganti-dengan-string-acak-panjang

# ─── Penyimpanan berkas: Cloudflare R2 ───────────────────────────────────────
# NestJS sekarang menjadi satu-satunya pemilik kredensial R2.
# Upload/delete berkas dilayani endpoint /api/storage/upload (StorageController).
# apps/web TIDAK lagi butuh CLOUDFLARE_R2_* — hapus dari apps/web/.env.local.
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=acca
# URL publik bucket. Gunakan custom domain, bukan pub-*.r2.dev bawaan:
# sebagian ISP Indonesia memblokir zona r2.dev di level DNS.
CLOUDFLARE_R2_PUBLIC_URL=
