# ==============================================================================
# ACCA CBT - Root Environment Configuration (Docker & Monorepo)
# ==============================================================================

# ─── Port Host (Hanya Web yang di-publish ke host VPS) ─────────────────────────
CBT_WEB_PORT=3008

# ─── URL Publik Aplikasi ──────────────────────────────────────────────────────
# Ganti dengan domain produksi Anda
NEXT_PUBLIC_SITE_URL=https://cbt.domainanda.sch.id
NEXT_PUBLIC_ACCA_URL=https://app.domainanda.sch.id

# ─── Database PostgreSQL ──────────────────────────────────────────────────────
# Jika PostgreSQL terpasang di host VPS yang sama dengan Docker:
# Gunakan "host.docker.internal" agar kontainer Docker dapat menjangkau host VPS.
# Format: postgresql://[user]:[password]@host.docker.internal:5432/[db_name]?schema=public
DATABASE_URL="postgresql://postgres:password_anda@host.docker.internal:5432/acca_db?schema=public"

# ─── Autentikasi & SSO ────────────────────────────────────────────────────────
# JWT_SECRET & CBT_SSO_SECRET WAJIB sama persis dengan yang ada di acca-new
JWT_SECRET=rahasia_jwt_anda_yang_sangat_panjang_dan_aman
JWT_EXPIRES_IN=12h
CBT_SSO_SECRET=rahasia_sso_antara_acca_dan_cbt
INTERNAL_API_KEY=kunci_rahasia_komunikasi_internal_nextjs_nestjs
SCORING_API_KEY=kunci_rahasia_komunikasi_nestjs_scoring
# Minimal 32 karakter; tanpa nilai ini ekspor/impor backup sengaja dinonaktifkan.
BACKUP_SECRET_KEY=kunci_hmac_backup_minimal_32_karakter_yang_acak

# ─── Data Organisasi / Sekolah ────────────────────────────────────────────────
CBT_ORGANIZATION_NAME="MAN Insan Cendekia Gowa"
CBT_ORGANIZATION_SLUG="man-ic-gowa"

# ─── Penyimpanan Berkas: Cloudflare R2 ────────────────────────────────────────
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=acca
CLOUDFLARE_R2_PUBLIC_URL=https://pub-xxxxxx.r2.dev

# WAJIB di produksi bila screenshot ujian dipakai: rahasia acak minimal 32 karakter, KHUSUS untuk bukti
# (jangan sama dengan JWT_SECRET, yang dipakai bersama acca-new). Tanpa ini, unggahan screenshot ditolak
# di produksi. Di luar produksi turunan JWT_SECRET dipakai. Bukti lama yang dienkripsi dengan JWT_SECRET
# tetap terbaca selama JWT_SECRET tidak diganti. Jangan rotasi kunci ini selama bukti 7 hari masih diperlukan.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SCREENSHOT_ENCRYPTION_KEY=

# ─── Layanan AI & Skoring ─────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
SCORING_LOG_LEVEL=INFO

# Layanan compiler LaTeX terisolasi; Docker Compose mengatur ini untuk API.
LATEX_RENDERER_URL=http://cbt-latex:8010
